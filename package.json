{
  "name": "hesabyar-bot",
  "version": "1.0.0",
  "description": "Telegram Personal Accounting Bot on Cloudflare Workers with AI, Voice, Excel and Charts",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "d1:init": "wrangler d1 execute hesabyar-db --local --file=./schema.sql",
    "d1:init:prod": "wrangler d1 execute hesabyar-db --remote --file=./schema.sql"
  },
  "keywords": ["telegram-bot", "cloudflare-workers", "accounting", "grammy", "workers-ai", "d1"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "grammy": "^1.35.0",
    "jalaali-js": "^1.2.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/jalaali-js": "^1.1.3",
    "typescript": "^5.7.3",
    "wrangler": "^3.114.0"
  }
}
